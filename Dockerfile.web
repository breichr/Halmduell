FROM oven/bun:1.3-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile --filter @halmduell/web

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN cd apps/web && bun run build

FROM oven/bun:1.3-alpine
WORKDIR /app
# adapter-node bündelt alle Laufzeit-Abhängigkeiten in build/
COPY --from=build /app/apps/web/build ./build
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
# 127.0.0.1 statt localhost: auf Hosts mit IPv6 löst localhost zu ::1 auf,
# der Server lauscht aber nur auf IPv4. Greift in Coolify nur, wenn der
# Dashboard-Healthcheck deaktiviert ist (siehe README, Deployment).
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT:-3000}/" || exit 1
CMD ["bun", "build/index.js"]
