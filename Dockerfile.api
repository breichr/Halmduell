FROM oven/bun:1.3-alpine
WORKDIR /app

# Nur die Manifeste zuerst kopieren, damit der Install-Layer gecacht wird
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile --production --filter @halmduell/api

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
# Fragenkatalog – wird beim Start importiert
COPY fragen fragen

ENV NODE_ENV=production
EXPOSE 3000
# 127.0.0.1 statt localhost (siehe Dockerfile.web); längere Startphase, weil
# vor dem Start Migrationen und der Fragen-Import laufen
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT:-3000}/api/health" || exit 1
WORKDIR /app/apps/api
# Migrationen anwenden, fragen/fragen.csv importieren, API starten
CMD ["bun", "run", "start"]
