# Lokale Entwicklung (passt zu docker-compose.yml) – nach apps/api/.env kopieren
DATABASE_URL=postgres://halmduell:halmduell@localhost:5432/halmduell
PORT=3000

# Signiert die Session-Tokens. Mindestens 32 Zeichen, in Produktion geheim halten:
#   openssl rand -base64 48
JWT_SECRET=nur-fuer-lokale-entwicklung-bitte-aendern-1234567890

# Hinter einem Reverse-Proxy (Coolify) auf true setzen, sonst false lassen
TRUST_PROXY=false

# Für Integrationstests (wird bei jedem Testlauf geleert, Name muss "test" enthalten)
TEST_DATABASE_URL=postgres://halmduell:halmduell@localhost:5432/halmduell_test

# Web Push (optional; ohne diese Werte ist es aus). Erzeugen: bun run push:schluessel
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@example.org
