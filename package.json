{
  "name": "halmduell",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "dev:api": "bun --filter @halmduell/api dev",
    "dev:web": "bun --filter @halmduell/web dev",
    "build": "bun --filter @halmduell/web build",
    "check": "bun --filter '*' check",
    "test": "bun --filter '*' test",
    "db:up": "docker compose up -d db",
    "db:generate": "bun --filter @halmduell/api db:generate",
    "db:migrate": "bun --filter @halmduell/api db:migrate",
    "db:seed": "bun --filter @halmduell/api db:seed",
    "fragen:import": "bun --filter @halmduell/api fragen:import",
    "fragen:pruefen": "bun --filter @halmduell/api fragen:pruefen"
  }
}
