{
  "name": "@halmduell/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/db/migrate.ts && bun src/fragen/import.ts && bun src/index.ts",
    "check": "tsc --noEmit -p .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts",
    "db:check": "drizzle-kit check",
    "fragen:import": "bun src/fragen/import.ts",
    "fragen:pruefen": "bun src/fragen/import.ts --pruefen",
    "push:schluessel": "bun src/push-schluessel.ts"
  },
  "dependencies": {
    "@halmduell/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
